  .pmd-dirs li.stop button { color: #6b4500; font-weight: 600; }
  #pmd-print tr.stop td { background: #fff6dd; }
  .pmd-dirs .brk, #pmd-print .brk { font-size: 13px; font-weight: 600; color: #8a5a00; margin-top: 4px; }
  .pmd-rest { display: inline-block; height: 22px; padding: 0 6px; border-radius: 11px; background: #e0a100; border: 2px solid #fff;
    color: #fff; font: 700 11px/18px var(--font-body); white-space: nowrap; box-shadow: 0 1px 4px rgb(0 0 0 / .4); transform: translateX(-25%); }
  .pmd-dirs .det { font-size: 12px; line-height: 1.45; color: var(--muted); margin-top: 3px; }
  .pmd-dirs ol:not(.verbose) .det { display: none; }
  .pmd-dirs .pmd-check { font-size: 13px; margin: 0 0 8px; }
  #pmd-print { display: none; }
  @media print {
    body > :not(#pmd-print) { display: none !important; }
    #pmd-print { display: block !important; color: #000; background: #fff; font: 13pt/1.4 var(--font-body); }
    @page { margin: 12mm; }
  }
  #pmd-print h1 { font: 700 22pt/1.2 var(--font-head); margin: 0 0 4px; }
  #pmd-print .pm { color: #333; margin: 0 0 10px; }
  #pmd-print .stats { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14pt; margin: 6px 0 10px; }
  #pmd-print table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  #pmd-print td { border-top: 1px solid #bbb; padding: 6px 6px; vertical-align: top; }
  #pmd-print tr { break-inside: avoid; }
  #pmd-print td.n { font-weight: 700; width: 2em; }
  #pmd-print td.d { white-space: nowrap; color: #333; width: 6em; }
  #pmd-print .warn, #pmd-print .fine { font-size: 10pt; color: #333; }
  #pmd-print .pmd-prof { height: 90px; color: #004AAD; }
  #pmd-print .qrs { break-inside: avoid; margin-top: 14px; }
  #pmd-print .qrs h2 { font: 700 15pt var(--font-head); margin: 0 0 4px; }
  #pmd-print .qrgrid { display: flex; flex-wrap: wrap; gap: 14px; }
  #pmd-print .qr { margin: 0; width: 38mm; text-align: center; break-inside: avoid; }
  #pmd-print .qr svg { width: 38mm; height: 38mm; display: block; }
  #pmd-print .qr figcaption { font-size: 10pt; margin-top: 2px; }
  .pmd-snip { position: relative; overflow: hidden; background: #eee; border: 1px solid #999; border-radius: 6px; }
  .pmd-snip img { position: absolute; width: 256px; height: 256px; max-width: none; }
  .pmd-snip svg { position: absolute; inset: 0; }
  .pmd-rules p { font-size: 13px; color: var(--muted); }
  .pmd-credit { font-size: 12px; color: var(--muted); margin: auto 0 0; }
  .pmd-pop { display: grid; gap: 8px; min-width: 170px; }
  .pmd-pop button { height: 44px; border-radius: 10px; border: 0; color: #fff; font: 600 15px var(--font-body); cursor: pointer; }
  .pmd-pop .a { background: #1f9d55; } .pmd-pop .b { background: #d64545; } .pmd-pop .v { background: #e08a00; }
  .pmd-pin { width: 30px; height: 30px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); border: 3px solid #fff;
    box-shadow: 0 2px 6px rgb(0 0 0 / .35); display: grid; place-items: center; }
  .pmd-pin span { transform: rotate(45deg); color: #fff; font: 700 13px var(--font-body); }

  @media (max-width: 760px) {
    .pmd-head { padding: 16px 0 8px; }
    .pmd-head p { display: none; }
    .pmd-head h1 { font-size: 28px; }
    .pmd { height: calc(100dvh - 96px); }
    .pmd-panel { left: 0; right: 0; bottom: 0; top: auto; width: auto; max-height: 75%; border-radius: 18px 18px 0 0;
      padding: 6px 16px calc(14px + env(safe-area-inset-bottom)); transition: transform .25s ease; }
    .pmd-panel.collapsed { transform: translateY(calc(100% - 196px)); }
    .pmd-griprow { display: flex; align-items: center; gap: 8px; }
    .pmd-tab { display: none; }
    .pmd.expanded .pmd-panel { top: 0; right: 0; max-height: none; border-radius: 0; transform: none; padding-bottom: 140px; }
    .pmd.expanded .pmd-map { width: 140px; height: 110px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); }
    .pmd-grip { display: block; flex: 1; height: 32px; border: 0; background: none; cursor: pointer; padding: 0 0 0 60px; }
    .pmd-grip span { display: block; margin: 0 auto; width: 44px; height: 5px; border-radius: 3px; background: var(--line); }
    .pmd-suggest { left: 0; right: 0; }
    .pmd-places { gap: 6px; }
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  const BBOX = { s: -28.27, w: 152.35, n: -26.80, e: 153.56 };
  // category id -> label, colour (same ids as build.py / router.worker.js)
  const CATS = [
    ["Bikeway", "#1f9d55"], ["Shared path", "#14a3a3"], ["Footpath", "#e0a100"], ["Quiet street", "#3d7fe0"],
    ["Main road ≤ 60", "#d64545"], ["Road bike lane", "#7b61ff"], ["Crossing", "#8a8f98"], ["Track / unsealed", "#8b5a2b"],
    ["Footpath beside a fast road", "#e0a100"], ["Road over 60 km/h", "#8f1d1d"], ["Bike lane on a fast road", "#b04ad6"],
    ["Ferry (CityCat etc.)", "#0b3d91"],
  ];
  const MODES = {
    bike: { label: "bicycles", speed: 22, max: 35, roads: "bikeways", foot: "(give way to pedestrians)" },
    ebike: { label: "e-bikes", speed: 25, max: 35, roads: "bikeways", wh: 8, foot: "(12 km/h limit)" },
    pmd: { label: "e-scooters, EUCs and e-skateboards", speed: 20, max: 25, roads: "bikeways", wh: 15, foot: "(12 km/h limit)" },
  };
  // What the planner does with each kind of path/road, per ride type: [type, allowed, treatment].
  // allowed: "yes" | "no" | "maybe". Keep in line with build.py (legality) and router.worker.js (costs).
  const RULES = {
    pmd: [
      ["Bikeways and separated paths", "yes", "Preferred. 25 km/h; on separated paths, the bicycle side only."],
      ["Shared paths", "yes", "Preferred. 25 km/h, 12 km/h when passing pedestrians."],
      ["Footpaths", "yes", "Used, a little less than shared paths (12 km/h). Your Footpaths option changes how much."],
      ["Road crossings", "yes", "12 km/h on the crossing; a small time penalty for stopping first."],
      ["Quiet streets (60 km/h or less)", "yes", "Avoided unless needed; set by your Roads option."],
      ["Main roads (60 km/h or less)", "yes", "Strongly avoided unless you pick \"Any legal road\"."],
      ["On-road bike lanes (60 km/h or less)", "yes", "Preferred over other roads. Never against traffic."],
      ["Roads over 60 km/h, incl. painted bike lanes", "no", "Never used."],
      ["Bike lanes physically separated from fast roads", "yes", "Used like a bikeway."],
      ["Footpath beside a fast road (not mapped separately)", "yes", "Used as a footpath (12 km/h)."],
      ["Motorways", "no", "Never used."],
      ["One-way roads", "maybe", "Legal direction only. \"Except bicycles\" exemptions don't cover PMDs."],
      ["Paths signed \"no bicycles\"", "maybe", "Not a PMD rule, but avoided (or never used, if you choose)."],
      ["Roads signed \"no bicycles\"", "no", "Never used (to be safe)."],
      ["Areas signed \"no PMDs\" (malls, esplanades, jetties)", "no", "Avoided only where the map records it, which is rare. Check signs."],
      ["Unsealed tracks", "yes", "Avoided or excluded by your Surface option."],
      ["Paths signed \"dismount\" (ferry gangways, campus courts)", "maybe", "Walked: timed at 5 km/h and used only when it's worth it."],
      ["CityCat, CityHopper, cross-river ferries, Moggill ferry, Gold Coast Hopo", "yes", "Used when quicker, unless you pick Avoid. Assumes a wait to board (about 10 min on the river, 5 at Moggill, 15 for Hopo) and 18 km/h on the water. Bikes and e-scooters go free if there's room (crew's call). Island and tourist ferries aren't included."],
    ],
    bike: [
      ["Bikeways and separated paths", "yes", "Preferred. On separated paths, the bicycle side only."],
      ["Shared paths", "yes", "Preferred. Keep left and give way to pedestrians."],
      ["Footpaths", "yes", "Allowed unless signed. Used less than bikeways; give way to pedestrians."],
      ["Road crossings", "yes", "Stop first at zebra crossings; small time penalty."],
      ["On-road bike lanes", "yes", "Preferred over other roads. Never against traffic."],
      ["Quiet streets", "yes", "Used when bikeways don't go there; set by your Roads option."],
      ["Main roads (60 km/h or less)", "yes", "Avoided unless needed, or freely with \"Any legal road\"."],
      ["Roads over 60 km/h", "yes", "Last resort only, unless you pick \"Any legal road\". A painted bike lane or shoulder makes them less bad."],
      ["Motorways", "maybe", "Only where the map says bicycles are allowed."],
      ["One-way roads", "maybe", "Legal direction, plus the other way where bicycles are exempted (contraflow)."],
      ["Paths or roads signed \"no bicycles\"", "no", "Never used."],
      ["Unsealed tracks", "yes", "Avoided or excluded by your Surface option."],
      ["Paths signed \"dismount\" (ferry gangways, campus courts)", "maybe", "Walked: timed at 5 km/h and used only when it's worth it."],
      ["CityCat, CityHopper, cross-river ferries, Moggill ferry, Gold Coast Hopo", "yes", "Used when quicker, unless you pick Avoid. Assumes a wait to board (about 10 min on the river, 5 at Moggill, 15 for Hopo) and 18 km/h on the water. Bikes and e-scooters go free if there's room (crew's call). Island and tourist ferries aren't included."],
    ],
  };
  RULES.ebike = RULES.bike.map((r) => r[0] === "Footpaths" ? [r[0], r[1], "Allowed unless signed. 12 km/h, used less than bikeways."]
    : r[0] === "Shared paths" ? [r[0], r[1], "Preferred. 12 km/h when passing pedestrians."] : r);
  const NOTES = {
    common: [
      "Speed limits missing from the map are guessed: local streets 50 km/h, tertiary roads 60 km/h, bigger roads over 60 km/h. Routes say when they use a guessed road.",
      "Rest stops get a star rating out of 5 from what OpenStreetMap shows within about 40 m of the route: toilets 1.5⭐, drinking water 1.25⭐, shelter 1⭐, cafe 0.75⭐, picnic table 0.5⭐, bench 0.5⭐, bike repair stand 0.25⭐ (rounded to half stars). It rates facilities, not reviews. Breaks use stops rated 1.5/5⭐ or more; Google Maps parts hand over at the best stop near where a split is needed.",
      "Hills cost extra by ride type (most for bicycles, least for e-bikes); \"Avoid\" also doubles the cost of grades over 8 %.",
    ],
    pmd: [["qld.gov.au: rules for personal mobility devices", "https://www.qld.gov.au/transport/safety/rules/wheeled-devices/personal-mobility-devices", "page updated 26 Aug 2026"],
      ["StreetSmarts: new e-mobility laws from 1 July 2026", "https://tmr.qld.gov.au/e-bikes-e-scooters/", ""],
      ["Translink: bikes and e-scooters on CityCats and ferries", "https://translink.com.au/travel-with-us/cycling-and-walking", ""]],
    bike: [["qld.gov.au: bicycle road rules and safety", "https://www.qld.gov.au/transport/safety/rules/wheeled-devices/bicycle", "page updated 1 Jul 2026"],
      ["Translink: bikes on CityCats and ferries", "https://translink.com.au/travel-with-us/cycling-and-walking", ""]],
    ebike: [["qld.gov.au: bicycle road rules and safety", "https://www.qld.gov.au/transport/safety/rules/wheeled-devices/bicycle", "page updated 1 Jul 2026"],
      ["StreetSmarts: 12 km/h footpath limit for e-bikes from 1 July 2026", "https://tmr.qld.gov.au/e-bikes-e-scooters/", ""],
      ["Translink: bikes on CityCats and ferries", "https://translink.com.au/travel-with-us/cycling-and-walking", ""]],
  };
  // defaults: bikeways first, some hills, some footpaths, a 10 min break about every hour
  const BASE = { roads: "bikeways", footpaths: "normal", surface: "good", noBikeSigns: "avoid", hills: "some", ferries: "use", breaks: "60", breakMin: "10", lit: false };
  const ROADS_HINT = { pmd: "Roads over 60 km/h are never used.", bike: "\"Any legal road\" includes fast roads; the others keep you off them.", ebike: "\"Any legal road\" includes fast roads; the others keep you off them." };

  const $ = (id) => document.getElementById(id);
  const root = $("pmd"), panel = $("pmd-panel"), status = $("pmd-status"), result = $("pmd-result");
  const store = { get(k) { try { return JSON.parse(localStorage.getItem(k)); } catch { return null; } },
                  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} } };

  // ---- state: mode, points and prefs, mirrored in the URL so a route can be shared ----
  const qs = new URLSearchParams(location.search);
  const parsePt = (s) => { const p = (s || "").split(",").map(Number); return p.length === 2 && p.every(isFinite) ? p : null; };
  const defaults = (mode) => ({ ...BASE, mode, roads: MODES[mode].roads, speed: MODES[mode].speed, wh: MODES[mode].wh || 0 });
  const urlMode = MODES[qs.get("mode")] ? qs.get("mode") : null;
  let mode = urlMode || store.get("ride-mode");
  let prefs = null;
  function loadPrefs(m) {
    const p = { ...defaults(m), ...(store.get(`ride-prefs-${m}`) || {}), mode: m };
    for (const k of Object.keys(BASE).concat("speed", "wh")) if (qs.has(k) && m === urlMode)
      p[k] = k === "speed" || k === "wh" ? +qs.get(k) : k === "lit" ? qs.get(k) === "1" : qs.get(k);
    return p;
  }
  const pts = { a: parsePt(qs.get("a")), b: parsePt(qs.get("b")) };

  // ---- map ----
  const map = L.map("pmd-map", { zoomControl: false }).setView([-27.47, 153.02], 11);
  L.control.zoom({ position: "topright" }).addTo(map);
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19,
    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
  L.rectangle([[BBOX.s, BBOX.w], [BBOX.n, BBOX.e]], { color: "#888", weight: 1, fill: false, dashArray: "4 6", interactive: false }).addTo(map);
  const routeLayer = L.layerGroup().addTo(map);
  const pin = (letter, colour) => L.divIcon({ className: "", iconSize: [30, 30], iconAnchor: [15, 30],
    html: `<div class="pmd-pin" style="background:${colour}"><span>${letter}</span></div>` });
  const markers = {};
  const input = (w) => $(w === "a" ? "pmd-from" : "pmd-to");
  function placeMarker(w) {
    if (!pts[w]) { markers[w]?.remove(); delete markers[w]; return; }
    if (markers[w]) { markers[w].setLatLng(pts[w]); return; }
    markers[w] = L.marker(pts[w], { draggable: true, icon: pin(w.toUpperCase(), w === "a" ? "#1f9d55" : "#d64545") }).addTo(map);
    markers[w].on("dragend", (e) => { const p = e.target.getLatLng(); setPoint(w, [p.lat, p.lng]); });
  }
  function setPoint(w, ll, label) {
    pts[w] = ll; placeMarker(w);
    input(w).value = label || `${ll[0].toFixed(5)}, ${ll[1].toFixed(5)}`;
    if (label === undefined) reverseName(w, ll);
    plan();
  }

  // Tap the map: one popup with two big buttons (instead of long-press menus that are hard on phones).
  map.on("click", (e) => {
    if (root.classList.contains("expanded")) { setExpanded(false); return; }
    if (!mode) return;
    const ll = [e.latlng.lat, e.latlng.lng];
    const div = document.createElement("div"); div.className = "pmd-pop";
    div.innerHTML = '<button class="a" type="button">Start here</button>'
      + (vias.length < MAX_STOPS ? '<button class="v" type="button">Add a stop here</button>' : "")
      + '<button class="b" type="button">Finish here</button>';
    const pop = L.popup({ closeButton: false, offset: [0, -4] }).setLatLng(e.latlng).setContent(div).openOn(map);
    div.querySelector(".a").onclick = () => { map.closePopup(pop); setPoint("a", ll); };
    div.querySelector(".b").onclick = () => { map.closePopup(pop); setPoint("b", ll); };
    const addHere = div.querySelector(".v");
    if (addHere) addHere.onclick = () => {
      map.closePopup(pop);
      const empty = vias.findIndex((v) => !v.ll); // fill an empty stop box first
      const i = empty >= 0 ? empty : vias.push({ ll: null, label: "" }) - 1;
      setVia(i, ll);
    };
  });

  // ---- search (Photon, limited to the planner area) ----
  const sug = $("pmd-suggest");
  let sugTimer = 0, sugAbort = null, sugSel = -1;
  const fmt = (f) => { const p = f.properties; const name = p.name || [p.housenumber, p.street].filter(Boolean).join(" ");
    const sub = [p.name && p.street ? [p.housenumber, p.street].filter(Boolean).join(" ") : "", p.district || p.locality, p.city].filter(Boolean).join(", ");
    return { name: name || sub, sub }; };
  let sugApply = null;
  function showSuggest(inp, apply, feats) {
    sugApply = apply; sugSel = -1;
    sug.innerHTML = "";
    for (const f of feats) {
      const { name, sub } = fmt(f), li = document.createElement("li");
      li.role = "option"; li.textContent = name;
      if (sub && sub !== name) { const s = document.createElement("small"); s.textContent = sub; li.append(s); }
      li.onpointerdown = (ev) => { ev.preventDefault(); pick(f); };
      sug.append(li);
    }
    sug.style.top = `${inp.offsetTop + inp.offsetHeight + 4}px`;
    sug.hidden = !feats.length;
  }
  function pick(f) {
    const [lon, lat] = f.geometry.coordinates;
    sug.hidden = true;
    sugApply([lat, lon], fmt(f).name);
    document.activeElement?.blur();
    map.setView([lat, lon], Math.max(map.getZoom(), 14));
  }
  // any place box (start, stops, finish): type to search, pick a suggestion -> apply(latlng, label)
  function attachSearch(inp, apply) {
    inp.addEventListener("input", () => {
      clearTimeout(sugTimer);
      const q = inp.value.trim();
      if (q.length < 3) { sug.hidden = true; return; }
      sugTimer = setTimeout(async () => {
        sugAbort?.abort(); sugAbort = new AbortController();
        try {
          const c = map.getCenter();
          const u = `https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=6&lang=en&lat=${c.lat}&lon=${c.lng}&bbox=${BBOX.w},${BBOX.s},${BBOX.e},${BBOX.n}`;
          const r = await fetch(u, { signal: sugAbort.signal });
          showSuggest(inp, apply, (await r.json()).features || []);
        } catch (err) { if (err.name !== "AbortError") showSuggest(inp, apply, []); }
      }, 300);
    });
    inp.addEventListener("keydown", (e) => {
      const items = [...sug.children];
      if (sug.hidden || !items.length) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault(); sugSel = (sugSel + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length;
        items.forEach((li, i) => li.setAttribute("aria-selected", String(i === sugSel)));
      } else if (e.key === "Enter") { e.preventDefault(); items[Math.max(sugSel, 0)].dispatchEvent(new Event("pointerdown")); }
      else if (e.key === "Escape") sug.hidden = true;
    });
    inp.addEventListener("focus", () => { panel.classList.remove("collapsed"); });
    inp.addEventListener("blur", () => setTimeout(() => { sug.hidden = true; }, 150));
  }
  attachSearch(input("a"), (ll, label) => setPoint("a", ll, label));
  attachSearch(input("b"), (ll, label) => setPoint("b", ll, label));
  async function placeName(ll) {
    try {
      const r = await fetch(`https://photon.komoot.io/reverse?lat=${ll[0]}&lon=${ll[1]}&lang=en`);
      const f = (await r.json()).features?.[0];
      return f ? fmt(f).name || fmt(f).sub : "";
    } catch { return ""; }
  }
  async function reverseName(which, ll) {
    const name = await placeName(ll);
    if (name && pts[which] === ll) input(which).value = name;
  }

  // ---- stops between start and finish (multi-stop trip) ----
  const MAX_STOPS = 8;
  const vias = (qs.get("v") || "").split("|").map(parsePt).filter(Boolean).map((ll) => ({ ll, label: "" }));
  const viaMarkers = [];
  const llText = (ll) => `${ll[0].toFixed(5)}, ${ll[1].toFixed(5)}`;
  function renderVias() {
    const box = $("pmd-vias");
    box.innerHTML = "";
    vias.forEach((v, i) => {
      const row = document.createElement("div");
      row.className = "pmd-place";
      row.innerHTML = `<span class="pmd-dot v" aria-hidden="true">${i + 1}</span>
        <input type="search" placeholder="Stop ${i + 1}: search or tap the map" autocomplete="off" enterkeyhint="search" aria-label="Stop ${i + 1}">
        <button class="pmd-icon" type="button" aria-label="Remove stop ${i + 1}" title="Remove stop">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>`;
      const inp = row.querySelector("input");
      inp.value = v.label || (v.ll ? llText(v.ll) : "");
      attachSearch(inp, (ll, label) => setVia(i, ll, label));
      row.querySelector("button").onclick = () => { vias.splice(i, 1); renderVias(); plan(); };
      box.append(row);
    });
    for (const m of viaMarkers) m.remove();
    viaMarkers.length = 0;
    vias.forEach((v, i) => {
      if (!v.ll) return;
      const m = L.marker(v.ll, { draggable: true, icon: pin(String(i + 1), "#e08a00") }).addTo(map);
      m.on("dragend", (e) => { const p = e.target.getLatLng(); setVia(i, [p.lat, p.lng]); });
      viaMarkers.push(m);
    });
    $("pmd-addstop").hidden = vias.length >= MAX_STOPS;
  }
  function setVia(i, ll, label) {
    vias[i].ll = ll; vias[i].label = label || "";
    renderVias(); plan();
    if (label === undefined) placeName(ll).then((name) => { if (name && vias[i]?.ll === ll) viaNamed(i, name); });
  }
  // a stop's place name arrives after the route is drawn: refresh the box and the "Arrive at stop" step
  function viaNamed(i, name) { vias[i].label = name; renderVias(); if (last) draw(last, false); }
  $("pmd-addstop").onclick = () => {
    vias.push({ ll: null, label: "" }); renderVias();
    $("pmd-vias").lastElementChild.querySelector("input").focus();
  };

  // "Use my location": browsers only share it on secure (https) pages and after the visitor allows it; say which
  // problem it is, and retry once with the quicker network-based fix if GPS is slow (e.g. indoors)
  $("pmd-locate").onclick = () => {
    if (!navigator.geolocation) { say("This browser can't share your location.", true); return; }
    if (!window.isSecureContext) {
      say("Your location only works on a secure page (an address starting with https://). It works on midnight-lite.com.", true);
      return;
    }
    say("Finding you…");
    const ok = (p) => {
      const ll = [p.coords.latitude, p.coords.longitude];
      say(pts.b ? "" : "Got you. Now set the finish (B): search or tap the map.");
      setPoint("a", ll, "My location"); map.setView(ll, 15);
    };
    const fail = (err, retried) => {
      if (err.code === err.PERMISSION_DENIED) say("Location is blocked for this site. Allow it in your browser's site settings (on an iPhone, also check Settings > Privacy & Security > Location Services > Safari Websites), then try again.", true);
      else if (!retried) navigator.geolocation.getCurrentPosition(ok, (e) => fail(e, true), { enableHighAccuracy: false, timeout: 20000, maximumAge: 120000 });
      else say(err.code === err.TIMEOUT ? "Finding your location took too long. Try again with Wi-Fi or location services on." : "Your device couldn't work out where you are. Check that location services are on.", true);
    };
    navigator.geolocation.getCurrentPosition(ok, (e) => fail(e, false), { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
  };

  $("pmd-swap").onclick = () => {
    const la = input("a").value, lb = input("b").value;
    [pts.a, pts.b] = [pts.b, pts.a];
    for (const [w, label] of [["a", lb], ["b", la]]) { placeMarker(w); input(w).value = pts[w] ? label : ""; }
    vias.reverse(); renderVias();
    plan();
  };

  // ---- mode + options ----
  function syncControls() {
    for (const seg of document.querySelectorAll(".seg")) {
      const k = seg.dataset.pref;
      seg.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === prefs[k])));
    }
    const M = MODES[mode];
    $("pmd-lit").checked = prefs.lit;
    $("pmd-speed").max = M.max; $("pmd-speed").value = prefs.speed; $("pmd-speed-out").value = prefs.speed;
    $("pmd-wh-row").hidden = !M.wh; $("pmd-wh").value = prefs.wh; $("pmd-wh-out").value = prefs.wh;
    $("pmd-nobike-row").hidden = mode !== "pmd";
    $("pmd-brk-len-row").hidden = prefs.breaks === "none";
    $("pmd-roads-hint").textContent = ROADS_HINT[mode];
    $("pmd-foot-hint").textContent = M.foot;
    $("pmd-rules-mode").textContent = M.label;
    $("pmd-rules-body").innerHTML = RULES[mode].map(([t, ok, how]) =>
      `<tr><td>${t}</td><td class="${ok}">${{ yes: "Yes", no: "No", maybe: "Partly" }[ok]}</td><td>${how}</td></tr>`).join("");
    $("pmd-rules-notes").innerHTML = NOTES.common.map((n) => `<li>${n}</li>`).join("") +
      NOTES[mode].map(([l, u, d]) => `<li>Source: <a href="${u}" rel="noopener">${l}</a>${d ? ` (${d})` : ""}.</li>`).join("");
    $("pmd-report").href = reportLink();
  }
  function reportLink() {
    const body = `Hi, a rule in the ride route planner looks out of date.\n\nRide type: ${MODES[mode].label}\nRules checked: ${root.dataset.checked}\nMap data: ${root.dataset.osm}\nPage: ${location.href}\n\nWhat's changed (and a link to the new rule, if you have one):\n`;
    return `mailto:${root.dataset.email}?subject=${encodeURIComponent("Route planner: rule update")}&body=${encodeURIComponent(body)}`;
  }
  function setMode(m) {
    mode = m; store.set("ride-mode", m);
    prefs = loadPrefs(m);
    $("pmd-modepick").hidden = true; $("pmd-main").hidden = false;
    syncControls(); plan();
  }
  document.querySelectorAll(".pmd-modes button").forEach((b) => { b.onclick = () => setMode(b.dataset.mode); });
  for (const seg of document.querySelectorAll(".seg")) {
    seg.addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      if (seg.dataset.pref === "mode") { if (b.dataset.v !== mode) setMode(b.dataset.v); return; }
      prefs[seg.dataset.pref] = b.dataset.v; prefsChanged();
    });
  }
  $("pmd-lit").onchange = (e) => { prefs.lit = e.target.checked; prefsChanged(); };
  $("pmd-speed").oninput = (e) => { prefs.speed = +e.target.value; $("pmd-speed-out").value = prefs.speed; };
  $("pmd-speed").onchange = () => prefsChanged();
  $("pmd-wh").oninput = (e) => { prefs.wh = +e.target.value; $("pmd-wh-out").value = prefs.wh; if (last) draw(last, false); };
  $("pmd-wh").onchange = () => store.set(`ride-prefs-${mode}`, prefs);
  $("pmd-reset").onclick = () => { prefs = defaults(mode); prefsChanged(); };
  function prefsChanged() { store.set(`ride-prefs-${mode}`, prefs); syncControls(); plan(); }

  // mobile bottom sheet
  $("pmd-grip").onclick = () => { if (!root.classList.contains("expanded")) panel.classList.toggle("collapsed"); };

  // expand: the panel takes the page, the map shrinks to a live thumbnail in the corner (tap it to come back)
  function setExpanded(on, refit = true) {
    root.classList.toggle("expanded", on);
    panel.classList.remove("collapsed");
    $("pmd-tab").setAttribute("aria-expanded", String(on));
    $("pmd-tab").setAttribute("aria-label", on ? "Show the full map" : "Expand the planner to full width");
    $("pmd-tab").title = on ? "Show the map" : "Expand";
    $("pmd-full").setAttribute("aria-expanded", String(on));
    $("pmd-full").textContent = on ? "Show map" : "Full screen";
    setTimeout(() => {
      map.invalidateSize();
      if (last && refit) map.fitBounds(L.latLngBounds(last.pts), { padding: on ? [10, 10] : [40, 40], paddingTopLeft: !on && window.innerWidth > 760 ? [420, 30] : [10, 10] });
    }, 260);
  }
  $("pmd-tab").onclick = () => setExpanded(!root.classList.contains("expanded"));
  $("pmd-full").onclick = () => setExpanded(!root.classList.contains("expanded"));

  // ---- router worker ----
  const worker = new Worker(new URL("../../pmd/router.worker.js", import.meta.url), { type: "module" });
  let ready = false, reqId = 0, last = null;
  const say = (msg, err = false) => { status.textContent = msg; status.classList.toggle("err", err); status.hidden = !msg; };
  worker.onmessage = ({ data }) => {
    if (data.type === "progress") { if (data.total) say(`Loading map data… ${Math.round(100 * data.got / data.total)} %`); }
    else if (data.type === "ready") { ready = true; say(pts.a && pts.b ? "" : "Search for places or tap the map to set the start (A) and finish (B)."); plan(); }
    else if (data.type === "error") say(data.message, true);
    else if (data.type === "route" && data.id === reqId) {
      if (data.error) { routeLayer.clearLayers(); result.hidden = true; last = null; say(data.error, true); return; }
      say(""); last = data; draw(data, true);
    }
  };
  worker.postMessage({ type: "load", url: root.dataset.graph });

  const inArea = (ll) => ll[0] >= BBOX.s && ll[0] <= BBOX.n && ll[1] >= BBOX.w && ll[1] <= BBOX.e;
  function plan() {
    const u = new URL(location.href);
    for (const w of ["a", "b"]) pts[w] ? u.searchParams.set(w, pts[w].map((v) => v.toFixed(5)).join(",")) : u.searchParams.delete(w);
    const stopLL = vias.filter((v) => v.ll).map((v) => v.ll);
    stopLL.length ? u.searchParams.set("v", stopLL.map((ll) => ll.map((x) => x.toFixed(5)).join(",")).join("|")) : u.searchParams.delete("v");
    if (mode) {
      u.searchParams.set("mode", mode);
      const d = defaults(mode);
      for (const k of Object.keys(BASE).concat("speed", "wh")) prefs[k] !== d[k] ? u.searchParams.set(k, k === "lit" ? (prefs[k] ? "1" : "0") : prefs[k]) : u.searchParams.delete(k);
    }
    history.replaceState(null, "", u);
    if (!mode || !pts.a || !pts.b || !ready) return;
    const points = [pts.a, ...stopLL, pts.b];
    if (!points.every(inArea)) { say("Start, stops and finish need to be inside the dashed box (Brisbane, Ipswich, Logan, Gold Coast, Moreton Bay).", true); return; }
    say("Planning…");
    worker.postMessage({ type: "route", id: ++reqId, points, prefs: { ...prefs } });
  }

  const km = (m) => m >= 1000 ? `${(m / 1000).toFixed(1)} km` : `${Math.round(m / 10) * 10} m`;
  const mins = (s) => s >= 3600 ? `${Math.floor(s / 3600)} h ${Math.round(s % 3600 / 60)} min` : `${Math.max(1, Math.round(s / 60))} min`;
  function profileSvg(prof) {
    const W = 340, H = 70, total = prof[prof.length - 1][0] || 1;
    let lo = Infinity, hi = -Infinity;
    for (const [, z] of prof) { lo = Math.min(lo, z); hi = Math.max(hi, z); }
    const span = Math.max(hi - lo, 20), base = lo - 2;
    const X = (d) => (d / total * W).toFixed(1), Y = (z) => (H - 4 - (z - base) / span * (H - 14)).toFixed(1);
    const line = prof.map(([d, z]) => `${X(d)},${Y(z)}`).join(" ");
    // labels are HTML, not SVG text, so the stretched (preserveAspectRatio="none") drawing doesn't distort them
    return `<div class="pmd-profw"><span class="hi">${Math.round(hi)} m</span><span class="lo">${Math.round(lo)} m</span>
      <svg class="pmd-prof" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="Elevation profile, ${Math.round(lo)} to ${Math.round(hi)} metres">
      <polygon points="0,${H - 4} ${line} ${W},${H - 4}" fill="currentColor" opacity=".15"/>
      <polyline points="${line}" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"/></svg></div>`;
  }
  function draw(r, refit) {
    routeLayer.clearLayers();
    const halo = L.polyline(r.pts, { color: "#fff", weight: 9, opacity: .9, interactive: false }).addTo(routeLayer);
    for (const run of r.runs) L.polyline(run.pts, { color: CATS[run.cat][1], weight: 5, opacity: .95, interactive: false,
      dashArray: run.cat === 2 || run.cat === 8 ? "1 8" : run.cat === 11 ? "10 8" : null, lineCap: "round" }).addTo(routeLayer);
    // dotted footpath runs need a solid base so they read as one line
    for (const run of r.runs) if (run.cat === 2 || run.cat === 8) L.polyline(run.pts, { color: CATS[2][1], weight: 3, opacity: .6, interactive: false }).addTo(routeLayer);
    for (const w of ["a", "b"]) markers[w]?.setZIndexOffset(1000);
    const { brk, legs, steps } = ridePlan(r);
    for (const b of brk) L.marker(b.at, { icon: L.divIcon({ className: "", iconSize: [22, 22], html: `<div class="pmd-rest">${restStars(b.mask)}/5⭐</div>` }) })
      .bindPopup(`Break: ${esc(restText(b))}`).addTo(routeLayer);
    // only move the map when the route isn't already fully in view (so toggling options doesn't jump around)
    const mobile = window.innerWidth <= 760;
    if (refit && !map.getBounds().contains(halo.getBounds()))
      map.fitBounds(halo.getBounds(), { paddingTopLeft: mobile ? [30, 30] : [420, 30], paddingBottomRight: mobile ? [30, 210] : [60, 30] });

    const s = r.stats, order = Object.entries(s.byCat).filter(([, m]) => m >= 10).sort((x, y) => y[1] - x[1]); // hide slivers

    const roads = [3, 4, 5, 9, 10].reduce((t, c) => t + (s.byCat[c] || 0), 0);
    const bikeways = (s.byCat[0] || 0) + (s.byCat[1] || 0) + (s.byCat[5] || 0) + (s.byCat[10] || 0);
    const warn = [];
    if (s.unknownSpeed > 50) warn.push(`${km(s.unknownSpeed)} on roads with no speed limit in the map data (guessed from the road type). Check the signs.`);
    if ((s.byCat[9] || 0) > 0) warn.push(`${km(s.byCat[9])} on roads over 60 km/h with no bike lane.`);
    if (s.noBike > 20) warn.push(`${km(s.noBike)} on paths mapped as "no bicycles". PMDs may be allowed, but look for signs.`);
    if (s.contra > 20) warn.push(`${km(s.contra)} against one-way traffic where bicycles are exempt.`);
    if (s.walk > 10) warn.push(`Walk your ${mode === "pmd" ? "device" : "bike"} for ${km(s.walk)} (signed "dismount", e.g. ferry gangways).`);
    if (s.ferries) warn.push(`${s.ferries} ferry trip${s.ferries > 1 ? "s" : ""} (${km(s.byCat[11])}), with about ${Math.round(s.ferryWait / 60)} min of waiting assumed. Check the timetable; bikes and e-scooters board if there's room.`);
    if (s.unpaved > 50) warn.push(`${km(s.unpaved)} unsealed.`);
    if (s.crossings) warn.push(`${s.crossings} path crossing${s.crossings > 1 ? "s" : ""} of roads${mode === "bike" ? "" : ": 12 km/h on crossings"}.`);
    const wh = MODES[mode].wh ? Math.round(prefs.wh * s.metres / 1000 + s.climb * (mode === "pmd" ? 0.39 : 0.2)) : 0;
    result.innerHTML = `
      <div class="pmd-sum"><b>${km(s.metres)}</b><span>about <strong>${mins(s.seconds + brk.length * breakSec())}</strong> at up to ${prefs.speed} km/h${brk.length ? `, including ${brk.length} break${brk.length > 1 ? "s" : ""}` : ""}</span>
        <span class="hint">${Math.round(100 * bikeways / s.metres)} % bikeways and bike lanes, ${Math.round(100 * roads / s.metres)} % on roads</span></div>
      <div class="pmd-bar">${order.map(([c, m]) => `<span style="width:${100 * m / s.metres}%;background:${CATS[c][1]}" title="${CATS[c][0]}"></span>`).join("")}</div>
      <ul class="pmd-legend">${order.map(([c, m]) => `<li><i style="background:${CATS[c][1]}"></i>${CATS[c][0]} ${km(m)}</li>`).join("")}</ul>
      <div class="pmd-hills"><span>▲ ${Math.round(s.climb)} m</span><span>▼ ${Math.round(s.descent)} m</span>
        <span>steepest ${Math.round(100 * s.steepest)} %</span>${wh ? `<span>≈ ${wh} Wh battery</span>` : ""}</div>
      ${profileSvg(r.profile)}
      ${wh ? `<p class="hint" style="margin:0">Battery estimate: ${prefs.wh} Wh/km on the flat plus the climbing for ~100 kg${mode === "ebike" ? " (with you pedalling)" : ""}. Rough; wind, stops and cold batteries add more.</p>` : ""}
      ${warn.length ? `<ul class="pmd-warn">${warn.map((w) => `<li>${w}</li>`).join("")}</ul>` : ""}
      <p class="pmd-ruleline">Planned with Queensland rules checked ${root.dataset.checked}. <a href="#pmd-rules" id="pmd-see-rules">See the rules used</a> · <a href="${reportLink()}">Report an out-of-date rule</a></p>
      <details class="pmd-dirs"><summary>Turn-by-turn (${steps.length - 1} steps)</summary>
        <label class="pmd-check"><input type="checkbox" id="pmd-verbose" ${verbose ? "checked" : ""}> More detail for each step</label>
        <ol class="${verbose ? "verbose" : ""}">${steps.map((t, i) => `<li class="${t.kind}">
        <button type="button" data-step="${i}">${esc(t.text)}</button>
        ${t.d ? `<div class="det">${esc(detail(t))}</div>` : ""}
        ${t.spot ? `<div class="det">${esc(restWhat(t.spot.mask))}</div>` : ""}
        <div class="meta">${t.metres ? `<span>${km(t.metres)}</span>` : ""}<span>at ${km(t.dist)}</span>
        ${t.at && t.cat !== 11 ? `<a href="${streetView(t)}" target="_blank" rel="noopener">Street View</a>` : ""}</div></li>`).join("")}</ol></details>
      ${googleBlock(r, legs)}
      <div class="pmd-actions"><button type="button" id="pmd-print-btn">Print / save PDF</button><button type="button" id="pmd-gpx">Download GPX</button><button type="button" id="pmd-share">Copy link</button></div>`;
    result.hidden = false;
    $("pmd-gpx").onclick = gpx;
    $("pmd-print-btn").onclick = printRoute;
    $("pmd-gm-live").onchange = (e) => {
      gmLive = e.target.checked; store.set("ride-gm-live", gmLive);
      $("pmd-gm-list").innerHTML = gmList(ridePlan(r).legs);
    };
    $("pmd-verbose").onchange = (e) => {
      verbose = e.target.checked; store.set("ride-verbose", verbose);
      result.querySelector(".pmd-dirs ol").classList.toggle("verbose", verbose);
    };
    result.querySelectorAll("[data-step]").forEach((b) => { b.onclick = () => focusStep(steps[+b.dataset.step]); });
    $("pmd-see-rules").onclick = (e) => { e.preventDefault(); $("pmd-rules").open = true; panel.classList.remove("collapsed");
      panel.scrollTo({ top: $("pmd-rules").offsetTop - 8, behavior: "smooth" }); };
    $("pmd-share").onclick = async () => {
      try { await navigator.clipboard.writeText(location.href); $("pmd-share").textContent = "Link copied"; }
      catch { prompt("Copy this link", location.href); }
    };
  }

  const esc = (t) => String(t).replace(/[<&>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  let verbose = !!store.get("ride-verbose");
  const COMPASS = ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"];
  // the small-print line under a step in "more detail" mode
  function detail(t) {
    const d = t.d, parts = [];
    const cats = Object.entries(d.cats).filter(([, m]) => m >= 5).sort((a, b) => b[1] - a[1]);
    if (cats.length) parts.push(cats.map(([c, m]) => `${CATS[c][0]} ${km(m)}`).join(", "));
    if (t.cat !== 11) parts.push(`heading ${COMPASS[Math.round(t.heading / 45) % 8]}`);
    parts.push(d.sec < 45 ? "under a minute" : `about ${mins(d.sec)}`);
    if (d.up >= 2 || d.dn >= 2) parts.push(`▲ ${Math.round(d.up)} m ▼ ${Math.round(d.dn)} m${d.steep >= 0.03 ? `, steepest ${Math.round(100 * d.steep)} %` : ""}`);
    if (mode !== "bike" && [2, 6, 8].some((c) => d.cats[c] >= 5)) parts.push("12 km/h limit on the footpath and crossings");
    else if (mode === "pmd") parts.push("25 km/h max");
    if (t.crossings) parts.push(`crosses ${t.crossings} road${t.crossings > 1 ? "s" : ""}`);
    if (d.wait) parts.push(`about ${Math.round(d.wait / 60)} min wait to board; check the timetable`);
    if (d.walk >= 5) parts.push(`walk your ${mode === "pmd" ? "device" : "bike"} ${km(d.walk)} (dismount sign)`);
    if (d.unpaved >= 20) parts.push(`unsealed ${km(d.unpaved)}`);
    if (d.lit >= 0.8 * t.metres && t.metres >= 50) parts.push("lit at night");
    if (d.contra >= 5) parts.push("against one-way traffic (bicycles exempt)");
    if (d.guess >= 50) parts.push("speed limit not in the map data: check the signs");
    if (d.nobike >= 5) parts.push("mapped as \"no bicycles\": look for signs");
    return parts.join(" · ");
  }
  // Everything the rider does, in order: the route's steps plus a "stop" step for each planned break and each
  // Google Maps hand-over (one step when they're the same rest stop). Part step ranges count these steps too, so the
  // QR captions, link list, screen list and PDF always agree.
  function ridePlan(r) {
    const brk = plannedBreaks(r), legs = googleLegs(r), stops = [];
    legs.slice(0, -1).forEach((g, k) => {
      if (g.ferryAfter) return; // the "Board the CityCat" step already marks it
      const b = g.end.spot && brk.includes(g.end.spot) ? g.end.spot : null;
      stops.push({ d: g.endD, idx: g.end.i, spot: g.end.spot, brk: b, part: k + 2 });
    });
    for (const b of brk) if (!stops.some((x) => x.brk === b)) stops.push({ d: b.d, idx: b.i, spot: b, brk: b, part: 0 });
    const P = r.pts, cum = [0];
    for (let i = 1; i < P.length; i++) cum.push(cum[i - 1] + mDist(P[i - 1], P[i]));
    const idxAt = (d) => { let i = 0; while (i < P.length - 1 && cum[i] < d) i++; return i; };
    const viaLL = vias.filter((v) => v.ll);
    for (const v of r.vias || []) stops.push({ d: v.d, idx: idxAt(v.d), via: v.n, label: viaLL[v.n - 1]?.label || "" });
    const stopText = (x) => {
      if (x.via) return `Arrive at stop ${x.via}${x.label ? `: ${x.label}` : ""}`;
      const where = x.spot ? `Stop at ${restText(x.spot)}` : "Pull off the path somewhere safe";
      const parts = [];
      if (x.brk) parts.push(`${+prefs.breakMin || 10} min break`);
      if (x.part) parts.push(`${x.brk ? "then " : ""}open Google Maps part ${x.part}${x.brk ? "" : " (if you're using it)"}`);
      return `${where}: ${parts.join(", ")}`;
    };
    const steps = [];
    r.steps.forEach((t, i) => {
      steps.push({ ...t, kind: "step" });
      if (t.idx < 0) return;
      for (const x of stops.filter((x) => stepAtDist(r, x.d) === i).sort((a, b) => a.d - b.d))
        steps.push({ kind: x.via ? "via" : "stop", text: stopText(x), at: x.spot ? x.spot.at : P[x.idx], idx: x.idx, dist: x.d, metres: 0,
          heading: t.heading, angle: 0, cat: -2, spot: x.spot, part: x.part, brk: !!x.brk });
    });
    // which numbered steps each Google Maps part covers
    let from = 0;
    legs.forEach((g, k) => {
      let to = steps.length - 1;
      if (k < legs.length - 1) to = g.ferryAfter
        ? steps.findIndex((t) => t.kind === "step" && t.cat === 11 && t.idx >= g.end.i - 1)
        : steps.findIndex((t) => t.kind === "stop" && t.part === k + 2);
      if (to < from) to = from;
      g.steps = [from + 1, to + 1];
      from = to;
    });
    return { brk, legs, steps };
  }
  const streetView = (t) => `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${t.at[0].toFixed(6)},${t.at[1].toFixed(6)}&heading=${Math.round(t.heading)}`;
  let stepMarker = null;
  function focusStep(t) {
    if (root.classList.contains("expanded")) { setExpanded(false, false); setTimeout(() => focusStep(t), 280); return; }
    const ll = t.at || last.pts[last.pts.length - 1];
    map.setView(ll, 18);
    stepMarker?.remove();
    stepMarker = L.circleMarker(ll, { radius: 10, color: "#004AAD", weight: 3, fill: false }).addTo(map);
    if (window.innerWidth <= 760) panel.classList.add("collapsed");
  }

  // ---- rest stops: a star rating out of 5 from what's there (OSM), used for breaks and Google Maps hand-overs ----
  // points per facility; 2 points = 1 star, rounded to half stars
  const REST = [[2, "toilets", 3], [1, "drinking water", 2.5], [4, "shelter", 2], [32, "cafe", 1.5], [16, "picnic table", 1], [8, "bench", 1], [64, "bike repair stand", 0.5]];
  const restScore = (m) => REST.reduce((t, [b, , w]) => t + (m & b ? w : 0), 0);
  const restStars = (m) => Math.max(0.5, Math.min(5, Math.round(restScore(m)) / 2));
  const stars = (m) => `(${restStars(m)}/5⭐)`; // e.g. "(3.5/5⭐)"
  const restWhat = (m) => REST.filter(([b]) => m & b).map(([, n]) => n).join(", ");
  const restText = (s) => `rest stop ${stars(s.mask)}${s.name ? ` (${s.name})` : ""}${verbose ? `: ${restWhat(s.mask)}` : ""}`;
  // best rest stop within `win` metres of distance d; a closer stop wins over a slightly better one further away
  function bestSpot(r, d, win, minScore = 1) {
    let best = null, bs = -Infinity;
    for (const s of r.spots || []) {
      const off = Math.abs(s.d - d), sc = restScore(s.mask);
      if (off > win || sc < minScore) continue;
      const v = sc - 3 * off / win;
      if (v > bs) { bs = v; best = s; }
    }
    return best;
  }
  const breakSec = () => (+prefs.breakMin || 10) * 60; // per break, added to the time estimate
  function plannedBreaks(r) {
    const every = +prefs.breaks || 0;
    if (!every || !r.spots?.length) return [];
    const pace = r.stats.metres / r.stats.seconds, gap = every * 60 * pace, out = [];
    for (let d = gap; d < r.stats.metres - gap * 0.3; d += gap) {
      const s = bestSpot(r, d, gap * 0.25, 3);
      if (s && !out.includes(s)) out.push(s);
    }
    return out;
  }
  // index of the step a route distance (or route point) falls in
  const stepAtDist = (r, d) => { let k = 0; r.steps.forEach((t, i) => { if (t.idx >= 0 && t.dist <= d) k = i; }); return k; };
  const stepAtIdx = (r, idx) => { let k = 0; r.steps.forEach((t, i) => { if (t.idx >= 0 && t.idx <= idx) k = i; }); return k; };

  // ---- Google Maps hand-off: the route as a few directions links, each start + up to 9 stops + finish ----
  // Pins sit ~25 m past turns (on the new path, so Google doesn't snap them to the road beside a bikeway) and fill
  // long stretches, so Google's own bike routing can't wander far from ours. Each part starts with an anchor stop
  // ANCHOR m along our path, because Google snaps a link's start to the nearest street. Parts hand over at planned
  // breaks, at the best rest stop near where a split is needed (somewhere to pull off the path, not mid-bikeway),
  // and at ferries.
  const GMAPS_STOPS = 9, ANCHOR = 60, PIN_AFTER_TURN = 25, PIN_GAP_MIN = 600, PIN_GAP_MIN_KEY = 250, PIN_GAP_MAX = 2000;
  const HANDOVER_WINDOW = 1000;
  const ONROAD = new Set([3, 4, 5, 9, 10]);
  function googleLegs(r) {
    const P = r.pts, cum = [0];
    for (let i = 1; i < P.length; i++) cum.push(cum[i - 1] + mDist(P[i - 1], P[i]));
    const at = (d) => { let i = 0; while (i < P.length - 1 && cum[i] < d) i++; return i; }; // first point at/after distance d
    const ferries = []; // [board idx, alight idx]
    r.steps.forEach((t, i) => { if (t.cat === 11 && r.steps[i + 1]?.idx >= 0) ferries.push([t.idx, r.steps[i + 1].idx]); });
    // candidate pins: turns; "key" ones switch between path and road (where Google would most likely go its own way)
    const cand = [];
    r.steps.forEach((t, i) => {
      if (i === 0 || t.idx <= 0 || t.cat === 11 || Math.abs(t.angle) < 25) return;
      cand.push({ i: at(cum[t.idx] + PIN_AFTER_TURN), key: ONROAD.has(t.cat) !== ONROAD.has(r.steps[i - 1].cat) });
    });
    const kept = [];
    for (const c of cand.sort((x, y) => x.i - y.i)) {
      const lastD = kept.length ? cum[kept[kept.length - 1]] : 0;
      if (cum[c.i] - lastD >= (c.key ? PIN_GAP_MIN_KEY : PIN_GAP_MIN)) kept.push(c.i);
    }
    for (const v of r.vias || []) kept.push(at(v.d)); // the trip's own stops are always pins
    kept.sort((x, y) => x - y);
    const pinSet = new Set(kept); // fill long gaps so Google can't take a shortcut down a busy road
    const marks = [0, ...kept, P.length - 1];
    for (let k = 1; k < marks.length; k++) {
      const gap = cum[marks[k]] - cum[marks[k - 1]], n = Math.floor(gap / PIN_GAP_MAX);
      for (let j = 1; j <= n; j++) pinSet.add(at(cum[marks[k - 1]] + gap * j / (n + 1)));
    }
    const pins = [...pinSet].sort((x, y) => x - y);
    const hand = (s) => ({ i: s.i, spot: s });
    const pieces = []; let from = 0; // riding between ferries
    for (const [b, a] of ferries) { pieces.push([from, b]); from = a; }
    pieces.push([from, P.length - 1]);
    const breaks = plannedBreaks(r), per = GMAPS_STOPS - 1, legs = [];
    pieces.forEach(([s0, s1], pi) => {
      const bounds = [{ i: s0 }, ...breaks.filter((b) => b.i > s0 && b.i < s1).map(hand), { i: s1 }];
      for (let k = 0; k < bounds.length - 1; k++) {
        const A = bounds[k], B = bounds[k + 1];
        const inner = (S, E) => pins.filter((i) => i > S.i && i < E.i && cum[i] - cum[S.i] > 40 && cum[E.i] - cum[i] > 40);
        const n = Math.max(1, Math.ceil((inner(A, B).length + 1) / (per + 1)));
        const sub = [A]; // extra hand-overs at the best rest stop near each even split
        for (let j = 1; j < n; j++) {
          const ideal = cum[A.i] + (cum[B.i] - cum[A.i]) * j / n, s = bestSpot(r, ideal, HANDOVER_WINDOW);
          const h = s ? hand(s) : { i: at(ideal) };
          if (h.i > sub[sub.length - 1].i && h.i < B.i) sub.push(h);
        }
        sub.push(B);
        for (let m = 0; m < sub.length - 1; m++) {
          const S = sub[m], E = sub[m + 1];
          let stops = inner(S, E);
          if (stops.length > per) stops = Array.from({ length: per }, (_, q) => stops[Math.round(q * (stops.length - 1) / (per - 1))]);
          const anchor = at(cum[S.i] + ANCHOR);
          if (anchor < E.i && cum[E.i] - cum[anchor] > 40 && (!stops.length || cum[stops[0]] - cum[anchor] > 40)) stops.unshift(anchor);
          legs.push({ start: S, end: E, stops, ferryAfter: k === bounds.length - 2 && m === sub.length - 2 && pi < pieces.length - 1 });
        }
      }
    });
    const llP = (i) => `${P[i][0].toFixed(5)},${P[i][1].toFixed(5)}`;
    const llH = (h) => h.spot ? `${h.spot.at[0].toFixed(5)},${h.spot.at[1].toFixed(5)}` : llP(h.i); // hand over AT the rest stop
    // "start from my location" (or part 1 when the start is "My location"): leave the origin out, so Google
    // navigates from the phone's live position; the anchor stop still pulls it onto the path
    const fromHere = input("a").value === "My location", lastStep = r.steps.length;
    return legs.map((g, i) => ({
      ...g, km: (cum[g.end.i] - cum[g.start.i]) / 1000, endD: cum[g.end.i],
      steps: [stepAtIdx(r, g.start.i) + 1, i === legs.length - 1 ? lastStep : stepAtIdx(r, Math.max(g.start.i, g.end.i - 1)) + 1],
      url: "https://www.google.com/maps/dir/?api=1&travelmode=bicycling" + (gmLive || (i === 0 && fromHere) ? "" : `&origin=${encodeURIComponent(llH(g.start))}`)
        + `&destination=${encodeURIComponent(llH(g.end))}` + (g.stops.length ? `&waypoints=${encodeURIComponent(g.stops.map(llP).join("|"))}` : ""),
    }));
  }
  let gmLive = !!store.get("ride-gm-live");
  const stepsLabel = (g) => g.steps[0] === g.steps[1] ? `step ${g.steps[0]}` : `steps ${g.steps[0]}–${g.steps[1]}`;
  const gmList = (legs) => legs.map((g, i) => `<li><a href="${g.url}" target="_blank" rel="noopener">Part ${i + 1}: ${g.km.toFixed(1)} km, ${stepsLabel(g)}</a>
        ${g.end.spot ? `<div class="meta">ends at a ${esc(restText(g.end.spot))}: pull off the path to open the next part</div>` : ""}
        ${g.ferryAfter ? `<div class="meta">then take the CityCat / ferry (not in Google's bike directions)</div>` : ""}</li>`).join("");
  function googleBlock(r, legs) {
    return `<details class="pmd-dirs pmd-gmaps"><summary>Open in Google Maps${legs.length > 1 ? ` (${legs.length} parts)` : ""}</summary>
      <p class="hint" style="margin:0 0 8px">Each part opens Google Maps bike directions with pins along this route${legs.length > 1 ? "; start the next part when you finish one" : ""}.
        Google picks its own way between pins, so if it disagrees with the map here, follow this route${mode === "pmd" ? " (Google has no e-scooter mode and doesn't know the 60 km/h rule)" : ""}.</p>
      <label class="pmd-check"><input type="checkbox" id="pmd-gm-live" ${gmLive ? "checked" : ""}> Start each link from my current location
        <span class="hint" style="margin:0">(open each part when you reach its start)</span></label>
      <ol id="pmd-gm-list">${gmList(legs)}</ol></details>`;
  }

  // ---- printable sheet: map snippets are plain OSM tile <img>s with an SVG overlay, so they print without canvas/CORS ----
  const TILE = "https://tile.openstreetmap.org";
  function project(ll, z) {
    const s = 256 * 2 ** z, sin = Math.sin(ll[0] * Math.PI / 180);
    return [(ll[1] + 180) / 360 * s, (0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI)) * s];
  }
  function snippet(center, z, w, h, layers) {
    const [cx, cy] = project(center, z), x0 = cx - w / 2, y0 = cy - h / 2;
    let tiles = "";
    for (let tx = Math.floor(x0 / 256); tx <= Math.floor((x0 + w) / 256); tx++)
      for (let ty = Math.floor(y0 / 256); ty <= Math.floor((y0 + h) / 256); ty++)
        tiles += `<img alt="" src="${TILE}/${z}/${tx}/${ty}.png" style="left:${tx * 256 - x0}px;top:${ty * 256 - y0}px">`;
    const pt = (ll) => { const [x, y] = project(ll, z); return `${(x - x0).toFixed(1)},${(y - y0).toFixed(1)}`; };
    const svg = layers.map((l) => l.circle
      ? `<circle cx="${pt(l.circle).split(",")[0]}" cy="${pt(l.circle).split(",")[1]}" r="${l.r || 7}" fill="${l.fill || "#fff"}" stroke="${l.color}" stroke-width="3"/>`
      : `<polyline points="${l.pts.map(pt).join(" ")}" fill="none" stroke="${l.color}" stroke-width="${l.width}" stroke-linecap="round" stroke-linejoin="round" ${l.arrow ? 'marker-end="url(#pmdArrow)"' : ""} opacity="${l.opacity || 1}"/>`).join("");
    return `<div class="pmd-snip" style="width:${w}px;height:${h}px">${tiles}<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
      <defs><marker id="pmdArrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#004AAD"/></marker></defs>${svg}</svg></div>`;
  }
  const mDist = (a, b) => Math.hypot((a[0] - b[0]) * 111320, (a[1] - b[1]) * 111320 * Math.cos(a[0] * Math.PI / 180));
  function around(pts, idx, back, fwd) { // route points within back/forward metres of pts[idx]
    let i = idx, d = 0; while (i > 0 && d < back) { d += mDist(pts[i], pts[i - 1]); i--; }
    let j = idx; d = 0; while (j < pts.length - 1 && d < fwd) { d += mDist(pts[j], pts[j + 1]); j++; }
    return [pts.slice(i, idx + 1), pts.slice(idx, j + 1)];
  }
  function fitZoom(pts, w, h) {
    for (let z = 17; z > 8; z--) {
      let x1 = Infinity, y1 = Infinity, x2 = -Infinity, y2 = -Infinity;
      for (const p of pts) { const [x, y] = project(p, z); x1 = Math.min(x1, x); x2 = Math.max(x2, x); y1 = Math.min(y1, y); y2 = Math.max(y2, y); }
      if (x2 - x1 < w - 40 && y2 - y1 < h - 40) return [z, [(y1 + y2) / 2, (x1 + x2) / 2]];
    }
    return [9, null];
  }
  function unproject([y, x], z) {
    const s = 256 * 2 ** z, n = Math.PI - 2 * Math.PI * y / s;
    return [180 / Math.PI * Math.atan(0.5 * (Math.exp(n) - Math.exp(-n))), x / s * 360 - 180];
  }
  // Google Maps parts as QR codes (error correction M) so the paper copy opens straight in the phone's Google Maps.
  // The library only loads when someone prints.
  async function googleQrs(r) {
    const { default: QRCode } = await import("qrcode");
    const legs = ridePlan(r).legs;
    const cards = await Promise.all(legs.map(async (g, i) => `<figure class="qr">
      ${await QRCode.toString(g.url, { type: "svg", errorCorrectionLevel: "M", margin: 2 })}
      <figcaption><b>Part ${i + 1}</b> · ${g.km.toFixed(1)} km<br>${stepsLabel(g)[0].toUpperCase() + stepsLabel(g).slice(1)}${g.end.spot ? `<br>ends at a rest stop at ${km(g.endD)} ${stars(g.end.spot.mask)}` : ""}${g.ferryAfter ? "<br>then the CityCat / ferry" : ""}</figcaption></figure>`));
    return `<section class="qrs"><h2>Open in Google Maps</h2>
      <p class="fine">Scan with your phone camera to open bike directions for each part${gmLive ? " from where you are (scan each one when you reach its start)" : ""}.
        Google picks its own way between pins; if it disagrees with this sheet, follow this sheet.</p>
      <div class="qrgrid">${cards.join("")}</div></section>`;
  }

  async function printRoute() {
    if (!last) return;
    const r = last, s = r.stats, P = r.pts, { brk: brkP, steps: stepsP } = ridePlan(r);
    const [z, c] = fitZoom(P, 680, 420);
    const overview = snippet(unproject(c, z), z, 680, 420, [
      { pts: P, color: "#fff", width: 8 }, { pts: P, color: "#004AAD", width: 4 },
      { circle: P[0], color: "#1f9d55", fill: "#1f9d55", r: 8 }, { circle: P[P.length - 1], color: "#d64545", fill: "#d64545", r: 8 }]);
    const rows = stepsP.map((t, i) => {
      const turn = t.at && (i === 0 || t.kind === "stop" || t.kind === "via" || Math.abs(t.angle) >= 25 || t.cat === 11 || t.cat === 6);
      let pic = "";
      if (turn && t.idx >= 0) {
        const [inn, out] = around(P, t.idx, 35, 45); // ~60 m each side fits a 220 px snippet at z18
        pic = snippet(t.at, 18, 220, 150, t.kind !== "step"
          ? [{ pts: [...inn, ...out], color: "#004AAD", width: 6 }, { circle: t.at, color: "#8a5a00", fill: "#e0a100", r: 9 }]
          : [{ pts: inn, color: "#7aa7e8", width: 6 }, { pts: out, color: "#004AAD", width: 6, arrow: true }, { circle: t.at, color: "#004AAD", r: 6 }]);
      }
      return `<tr class="${t.kind}"><td class="n">${i + 1}</td><td>${t.kind === "stop" ? `<div class="brk">${esc(t.text)}</div>` : esc(t.text)}${t.metres ? `<div class="fine">then ${km(t.metres)}</div>` : ""}
        ${verbose && t.d ? `<div class="fine">${esc(detail(t))}</div>` : ""}
        ${t.spot ? `<div class="fine">${esc(restWhat(t.spot.mask))}</div>` : ""}
        ${t.at && t.cat !== 11 ? `<div class="fine"><a href="${streetView(t)}">Street View</a></div>` : ""}</td><td class="d">${km(t.dist)}</td><td>${pic}</td></tr>`;
    }).join("");
    let el = $("pmd-print");
    if (!el) { el = document.createElement("div"); el.id = "pmd-print"; document.body.append(el); }
    const warns = [...result.querySelectorAll(".pmd-warn li")].map((li) => `<li>${esc(li.textContent)}</li>`).join("");
    const nVia = vias.filter((v) => v.ll).length;
    el.innerHTML = `<h1>${esc(input("a").value)} to ${esc(input("b").value)}${nVia ? ` <small>(${nVia} stop${nVia > 1 ? "s" : ""})</small>` : ""}</h1>
      <p class="pm">${esc(MODES[mode].label[0].toUpperCase() + MODES[mode].label.slice(1))} · printed ${new Date().toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })} · midnight-lite.com ride route planner</p>
      <div class="stats"><b>${km(s.metres)}</b><span>about ${mins(s.seconds + brkP.length * breakSec())} at up to ${prefs.speed} km/h${brkP.length ? ` incl. ${brkP.length} break${brkP.length > 1 ? "s" : ""}` : ""}</span><span>▲ ${Math.round(s.climb)} m ▼ ${Math.round(s.descent)} m</span><span>steepest ${Math.round(100 * s.steepest)} %</span></div>
      ${overview}${profileSvg(r.profile)}
      ${warns ? `<ul class="warn">${warns}</ul>` : ""}
      ${await googleQrs(r)}
      <table>${rows}</table>
      <p class="fine">Planned with Queensland rules checked ${root.dataset.checked}; map data (OpenStreetMap) ${root.dataset.osm}. Map data can be wrong:
        signs on the ground and the road rules always win. Report an out-of-date rule to ${esc(root.dataset.email)}.
        Map © OpenStreetMap contributors. Route link: ${esc(location.href)}</p>`;
    say("Preparing the printable page…");
    await Promise.all([...el.querySelectorAll("img")].map((img) => img.complete ? 0
      : new Promise((ok) => { img.onload = img.onerror = ok; setTimeout(ok, 8000); })));
    say("");
    window.print();
  }

  function gpx() {
    if (!last) return;
    const name = `${input("a").value} to ${input("b").value}`;
    const xml = `<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="midnight-lite.com ride route planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>${esc(name)}</name><copyright author="OpenStreetMap contributors"><license>https://opendatacommons.org/licenses/odbl/</license></copyright></metadata>
<trk><name>${esc(name)}</name><trkseg>
${last.pts.map(([a, b]) => `<trkpt lat="${a.toFixed(6)}" lon="${b.toFixed(6)}"/>`).join("\n")}
</trkseg></trk></gpx>`;
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([xml], { type: "application/gpx+xml" }));
    a.download = "ride-route.gpx"; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  // start: ask how they ride unless we know; restore points from a shared link
  if (mode) setMode(mode); else { $("pmd-modepick").hidden = false; say(""); }
  for (const w of ["a", "b"]) if (pts[w]) { placeMarker(w); input(w).value = `${pts[w][0].toFixed(5)}, ${pts[w][1].toFixed(5)}`; reverseName(w, pts[w]); }
  renderVias();
  vias.forEach((v, i) => placeName(v.ll).then((name) => { if (name && vias[i]?.ll === v.ll) viaNamed(i, name); }));
  if (pts.a && pts.b) map.fitBounds([pts.a, ...vias.map((v) => v.ll), pts.b], { padding: [40, 40] });
  if (window.innerWidth <= 760 && pts.a && pts.b && mode) panel.classList.add("collapsed");
</script>

---
import Base from "../../layouts/Base.astro";
import { site } from "../../lib/site";
// When the rules below were last checked against the qld.gov.au pages (update after re-checking them).
const RULES_CHECKED = "24 October 2026";
// Graph file is built by tools/pmd-graph/build.py from OpenStreetMap; the date in the name is the OSM extract date.
const GRAPH = { url: "/data/pmd/seq-20261024-v6.bin", date: "24 October 2026" };

// Search: the FAQ below is shown on the page and mirrored in FAQPage structured data (keep the two in step).
const FAQ = [
  ["Where can I ride an e-scooter in Queensland?",
    "On footpaths, shared paths and bike paths unless a sign says no PMDs (12 km/h on footpaths, 25 km/h elsewhere), and on roads and on-road bike lanes where the speed limit is 60 km/h or less. On faster roads only physically separated bike lanes. From 31 August 2026 riders need to be 16 and hold at least a learner licence. The planner follows these rules for e-scooters, e-skateboards and EUCs."],
  ["Can I take my bike or e-scooter on the CityCat?",
    "Yes. Translink lets bikes, e-scooters and other personal mobility devices on CityCats and ferries for free when there is room, at the crew's discretion. The planner can use the CityCat, CityHopper and cross-river ferries when they save time, or avoid them."],
  ["Does it cover the Gold Coast, Logan, Ipswich and Moreton Bay?",
    "Yes. It covers Brisbane, Ipswich, Logan, the Gold Coast, Moreton Bay and Redland: roughly from Caboolture and Bribie Island down to Coolangatta, and from Ipswich to the bay."],
  ["How does it avoid busy roads?",
    "Every bikeway, path and road from OpenStreetMap is scored by type, surface, speed limit and hills. The default \"bikeways first\" setting sticks to bikeways, shared paths and bike lanes and only uses roads when there is no sensible alternative. You can also choose quiet streets only, no roads at all, or any legal road."],
  ["How are hills worked out?",
    "From Geoscience Australia's LiDAR terrain model (bare earth, about 10 m detail), so trees and buildings don't add fake climbs. Each route shows the total climb and descent, the steepest grade, an elevation profile and, for e-scooters and e-bikes, a rough battery estimate."],
  ["Is it free, and does it track me?",
    "It is free, with no account. The route is worked out in your browser and nothing is sent to Midnight Lite. Place searches, and the street names looked up for points you tap, go to Photon (komoot); the map tiles come from OpenStreetMap."],
];
const jsonld = [
  { "@context": "https://schema.org", "@type": "WebApplication", name: "Bike and e-scooter route planner (SE Queensland)",
    url: "https://www.midnight-lite.com/tools/route-planner/", applicationCategory: "TravelApplication", operatingSystem: "Any (web browser)",
    browserRequirements: "Requires JavaScript", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "AUD" },
    description: "Free route planner for bikes, e-bikes, e-scooters, e-skateboards and EUCs around Brisbane, the Gold Coast, Logan, Ipswich and Moreton Bay. Bikeways first, legal roads only under Queensland's rules, hills from LiDAR, CityCat ferries, turn-by-turn directions and printable PDF.",
    featureList: ["Bikeways-first routing", "Queensland e-scooter (PMD) and bicycle road rules", "Hills and elevation profile", "CityCat and ferries", "Turn-by-turn directions with Street View links", "Print or save as PDF", "GPX export"],
    areaServed: ["Brisbane", "Gold Coast", "Logan", "Ipswich", "Moreton Bay", "Redland"].map((name) => ({ "@type": "City", name })),
    author: { "@type": "Organization", name: site.name, url: "https://www.midnight-lite.com/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Tools", item: "https://www.midnight-lite.com/tools/" },
    { "@type": "ListItem", position: 2, name: "Bike and e-scooter route planner", item: "https://www.midnight-lite.com/tools/route-planner/" }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: FAQ.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title="Brisbane bike & e-scooter route planner" page="tools" image="/img/tools/route-planner.jpg"
  description="Bike, e-bike, e-scooter and EUC route planner for Brisbane, Gold Coast, Logan, Ipswich and Moreton Bay. Free. Bikeways first, legal roads only, hills, CityCat.">
  <Fragment slot="head">{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}</Fragment>
  <section class="pmd-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/tools/">Tools</a> · Brisbane and SE Queensland</p>
      <h1>Bike and e-scooter route planner</h1>
      <p>Bikes, e-bikes, e-scooters, e-skateboards and EUCs around Brisbane, Ipswich, Logan, the Gold Coast and Moreton
        Bay. Bikeways first, only roads your ride is allowed on, and the hills counted. Runs in your browser.</p>
    </div>
  </section>

  <div class="pmd" id="pmd" data-graph={GRAPH.url} data-email={site.email} data-checked={RULES_CHECKED} data-osm={GRAPH.date}>
    <div class="pmd-map" id="pmd-map" aria-label="Map. Tap to set start or finish."></div>

    <button class="pmd-tab" id="pmd-tab" type="button" aria-label="Expand the planner to full width" aria-expanded="false" title="Expand">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="pmd-panel" id="pmd-panel">
      <div class="pmd-griprow">
        <button class="pmd-grip" id="pmd-grip" type="button" aria-label="Show or hide the planner"><span></span></button>
        <button class="pmd-full" id="pmd-full" type="button" aria-expanded="false">Full screen</button>
      </div>

      <!-- step 1: how are you riding? (shown until a mode is picked) -->
      <div class="pmd-modepick" id="pmd-modepick" hidden>
        <h2>How are you riding?</h2>
        <p class="hint">This sets which roads and paths are legal for you and how hills count.</p>
        <div class="pmd-modes">
          <button type="button" data-mode="bike"><b>Bicycle</b><span>Any road unless "no bicycles"; footpaths OK</span></button>
          <button type="button" data-mode="ebike"><b>E-bike</b><span>Like a bicycle; 12 km/h on footpaths</span></button>
          <button type="button" data-mode="pmd"><b>E-scooter, EUC or e-skate</b><span>Paths, and roads 60 km/h or less</span></button>
        </div>
      </div>

      <div class="pmd-main" id="pmd-main" hidden>
        <div class="seg seg-mode" data-pref="mode" role="group" aria-label="Ride type">
          <button type="button" data-v="bike">Bicycle</button>
          <button type="button" data-v="ebike">E-bike</button>
          <button type="button" data-v="pmd">E-scooter / EUC</button>
        </div>

        <div class="pmd-places">
          <div class="pmd-place">
            <span class="pmd-dot a" aria-hidden="true">A</span>
            <input id="pmd-from" type="search" placeholder="Start: search or tap the map" autocomplete="off" enterkeyhint="search" aria-label="Start">
            <button class="pmd-icon" id="pmd-locate" type="button" title="Use my location" aria-label="Use my location as the start">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </button>
          </div>
          <div id="pmd-vias" class="pmd-vias"></div>
          <div class="pmd-place">
            <span class="pmd-dot b" aria-hidden="true">B</span>
            <input id="pmd-to" type="search" placeholder="Finish: search or tap the map" autocomplete="off" enterkeyhint="search" aria-label="Finish">
            <button class="pmd-icon" id="pmd-swap" type="button" title="Swap start and finish" aria-label="Swap start and finish">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 4v14M7 18l-3-3M7 18l3-3M17 20V6M17 6l-3 3M17 6l3 3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <button class="pmd-addstop" id="pmd-addstop" type="button">+ Add stop</button>
          <ul class="pmd-suggest" id="pmd-suggest" role="listbox" hidden></ul>
        </div>

        <div class="pmd-status" id="pmd-status" role="status">Loading map data…</div>
        <div class="pmd-result" id="pmd-result" hidden></div>

        <details class="pmd-opts" id="pmd-opts">
          <summary>Route options</summary>
          <fieldset>
            <legend>Roads</legend>
            <div class="seg" data-pref="roads">
              <button type="button" data-v="bikeways">Bikeways first</button>
              <button type="button" data-v="avoid">Paths, roads if needed</button>
              <button type="button" data-v="quiet">Quiet streets OK</button>
              <button type="button" data-v="none">No roads</button>
              <button type="button" data-v="any">Any legal road</button>
            </div>
            <p class="hint" id="pmd-roads-hint"></p>
          </fieldset>
          <fieldset>
            <legend>Hills</legend>
            <div class="seg" data-pref="hills">
              <button type="button" data-v="ignore">Don't mind</button>
              <button type="button" data-v="some">Some</button>
              <button type="button" data-v="avoid">Avoid</button>
            </div>
          </fieldset>
          <fieldset>
            <legend>CityCat and ferries</legend>
            <div class="seg" data-pref="ferries">
              <button type="button" data-v="use">Use if quicker</button>
              <button type="button" data-v="avoid">Avoid</button>
            </div>
            <p class="hint">Times assume a typical wait to board (about 10 min on the river). Check the timetable.</p>
          </fieldset>
          <fieldset>
            <legend>Breaks</legend>
            <p class="pmd-sublabel" id="pmd-brk-often">How often (riding time between breaks)</p>
            <div class="seg" data-pref="breaks" role="group" aria-labelledby="pmd-brk-often">
              <button type="button" data-v="none">No breaks</button>
              <button type="button" data-v="30">Every 30 min</button>
              <button type="button" data-v="60">Every hour</button>
            </div>
            <div id="pmd-brk-len-row">
              <p class="pmd-sublabel" id="pmd-brk-len">How long each break lasts</p>
              <div class="seg" data-pref="breakMin" role="group" aria-labelledby="pmd-brk-len">
                <button type="button" data-v="5">5 min</button>
                <button type="button" data-v="10">10 min</button>
                <button type="button" data-v="15">15 min</button>
              </div>
            </div>
            <p class="hint">Each break is at the best rest stop near that point (rated out of 5 stars for toilets, water, shelter
              and seats), and its length is added to the trip time. Short rides may not need one.</p>
          </fieldset>
          <fieldset>
            <legend>Footpaths <span class="hint" id="pmd-foot-hint"></span></legend>
            <div class="seg" data-pref="footpaths">
              <button type="button" data-v="prefer">Fine</button>
              <button type="button" data-v="normal">Some</button>
              <button type="button" data-v="avoid">Avoid</button>
            </div>
          </fieldset>
          <fieldset>
            <legend>Surface</legend>
            <div class="seg" data-pref="surface">
              <button type="button" data-v="any">Any</button>
              <button type="button" data-v="good">Avoid rough</button>
              <button type="button" data-v="paved">Sealed only</button>
            </div>
          </fieldset>
          <fieldset id="pmd-nobike-row">
            <legend>Paths signed "no bicycles"</legend>
            <div class="seg" data-pref="noBikeSigns">
              <button type="button" data-v="avoid">Avoid</button>
              <button type="button" data-v="never">Never</button>
            </div>
          </fieldset>
          <label class="pmd-check"><input type="checkbox" id="pmd-lit"> Prefer lit paths (night)</label>
          <label class="pmd-range">Cruising speed <output id="pmd-speed-out">20</output> km/h
            <input type="range" id="pmd-speed" min="10" max="25" step="1" value="20"></label>
          <label class="pmd-range" id="pmd-wh-row">Battery use on the flat <output id="pmd-wh-out">15</output> Wh/km
            <input type="range" id="pmd-wh" min="5" max="40" step="1" value="15"></label>
          <button type="button" class="pmd-reset" id="pmd-reset">Reset options to defaults</button>
        </details>

        <details class="pmd-rules" id="pmd-rules">
          <summary>Rules used for <span id="pmd-rules-mode"></span> <span class="hint">(checked {RULES_CHECKED})</span></summary>
          <p class="hint">How the planner treats each kind of path and road for your ride type. If a rule here is out of
            date, please <a id="pmd-report" href="#">let me know</a> and I'll update the planner.</p>
          <table class="pmd-rtable"><thead><tr><th>Path or road</th><th>Allowed?</th><th>What the planner does</th></tr></thead>
            <tbody id="pmd-rules-body"></tbody></table>
          <ul id="pmd-rules-notes"></ul>
          <p><strong>Map data can be wrong or out of date.</strong> Paths and roads come from OpenStreetMap (extract {GRAPH.date}).
            "No PMD" signs are rarely mapped, and council bans (some malls, esplanades, jetties) may not show. Hills come
            from Geoscience Australia's LiDAR terrain model, or a coarser satellite one where there's no LiDAR. Signs on the
            ground and the road rules always win: you're responsible for riding legally and safely.</p>
        </details>

        <p class="pmd-credit">Paths and map © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.
          Elevation © <a href="https://www.ga.gov.au/" rel="noopener">Geoscience Australia</a> (CC BY 4.0) and Copernicus DEM (© ESA).
          Search by <a href="https://photon.komoot.io" rel="noopener">Photon</a>.</p>
      </div>
    </div>
  </div>

  <section class="pmd-about">
    <div class="wrap prose">
      <h2>How the planner picks a route</h2>
      <p>Pick how you ride (bicycle, e-bike, or e-scooter, EUC or e-skateboard), then set a start and finish by searching,
        tapping the map or using your location. The planner looks at every bikeway, shared path, footpath and road in
        Brisbane, Ipswich, Logan, the Gold Coast and Moreton Bay and finds the best route your ride is allowed to use under
        Queensland's road rules, with bikeways and bike lanes first.</p>
      <ul>
        <li><strong>Legal for your ride:</strong> e-scooters, e-skateboards and EUCs stay off roads over 60 km/h; bikes can use
          any road unless it's signed "no bicycles"; one-way streets are followed (with bicycle contraflow where allowed).</li>
        <li><strong>Hills counted:</strong> climb, descent, steepest grade and an elevation profile, plus a rough battery estimate for e-scooters and e-bikes.</li>
        <li><strong>CityCat and ferries:</strong> used when they're quicker than riding around the river.</li>
        <li><strong>Directions you can take with you:</strong> turn-by-turn steps with Street View links, GPX for your bike computer or phone,
          and a large-print page you can print or save as a PDF.</li>
      </ul>
      <h2>Questions</h2>
      {FAQ.map(([q, a]) => <details class="pmd-faq"><summary>{q}</summary><p>{a}</p></details>)}
      <p class="hint">Rules checked {RULES_CHECKED}. Spotted something out of date? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>

<style is:global>
  .pmd [hidden] { display: none !important; }
  .pmd-head { padding: 28px 0 12px; }
  .pmd-about { padding: 40px 0 56px; }
  .pmd-faq { border-bottom: 1px solid var(--line); padding: 4px 0; }
  .pmd-faq summary { cursor: pointer; font-weight: 600; padding: 10px 0; }
  .pmd-faq p { margin: 0 0 12px; color: var(--muted); }
  .pmd-head h1 { margin: 4px 0 6px; }
  .pmd-head p { margin: 0; color: var(--muted); max-width: 70ch; }
  .pmd { position: relative; height: calc(100dvh - 120px); min-height: 480px; border-top: 1px solid var(--line); }
  .pmd-map { position: absolute; inset: 0; background: var(--line); }
  .pmd-panel {
    position: absolute; z-index: 1000; left: 16px; top: 16px; bottom: 16px; width: 380px; overflow: auto;
    background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 8px 30px rgb(0 0 0 / .18); padding: 14px; display: flex; flex-direction: column; gap: 10px;
  }
  .pmd-main { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pmd-grip, .pmd-griprow { display: none; }
  /* expand control: a tab on the panel's right edge (desktop) / a button by the sheet handle (phone) */
  .pmd-tab { position: absolute; z-index: 1001; left: 396px; top: 50%; transform: translateY(-50%); width: 28px; height: 64px;
    border: 1px solid var(--line); border-left: 0; border-radius: 0 10px 10px 0; background: var(--surface); color: var(--text);
    box-shadow: 4px 4px 14px rgb(0 0 0 / .15); cursor: pointer; display: grid; place-items: center; padding: 0; }
  .pmd-tab svg { transition: transform .2s; }
  .pmd.expanded .pmd-tab { left: auto; right: 16px; border: 1px solid var(--line); border-radius: 10px 0 0 10px; }
  .pmd.expanded .pmd-tab svg { transform: rotate(180deg); }
  .pmd.expanded .pmd-panel { right: 52px; width: auto; align-items: center; padding-bottom: 210px; }
  .pmd.expanded .pmd-panel > * { width: min(100%, 820px); }
  .pmd.expanded .pmd-map { inset: auto 24px 24px auto; width: 260px; height: 180px; z-index: 1100; border-radius: 12px;
    border: 2px solid var(--surface); box-shadow: 0 8px 24px rgb(0 0 0 / .3); overflow: hidden; cursor: pointer; }
  .pmd.expanded .pmd-map .leaflet-control-container { display: none; }
  .pmd-full { border: 1px solid var(--line); background: var(--bg); color: var(--text); border-radius: 999px;
    font-size: 13px; height: 32px; padding: 0 12px; cursor: pointer; }
  .pmd-modepick h2 { margin: 4px 0; font-size: 22px; }
  .pmd-modes { display: grid; gap: 10px; margin-top: 10px; }
  .pmd-modes button { text-align: left; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); cursor: pointer; display: grid; gap: 4px; }
  .pmd-modes button b { font: 700 17px var(--font-body); }
  .pmd-modes button span { font-size: 13px; color: var(--muted); }
  .pmd-modes button:hover, .pmd-modes button:focus-visible { border-color: var(--blue); }
  .pmd-places { position: relative; display: grid; gap: 8px; }
  .pmd-place { display: flex; align-items: center; gap: 8px; }
  .pmd-place input {
    flex: 1; min-width: 0; height: 46px; font-size: 16px; /* 16px stops iOS zooming in */
    padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text);
  }
  .pmd-dot { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    font: 700 13px/1 var(--font-body); color: #fff; }
  .pmd-dot.a { background: #1f9d55; } .pmd-dot.b { background: #d64545; } .pmd-dot.v { background: #e08a00; }
  .pmd-vias { display: grid; gap: 8px; }
  .pmd-vias:empty { display: none; }
  .pmd-addstop { justify-self: start; margin-left: 36px; border: 0; background: none; color: var(--blue); font-size: 14px;
    font-weight: 600; cursor: pointer; padding: 2px 0; }
  .pmd-icon { flex: none; width: 46px; height: 46px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); display: grid; place-items: center; cursor: pointer; }
  .pmd-icon:active { transform: scale(.96); }
  .pmd-suggest { position: absolute; z-index: 5; left: 36px; right: 54px; top: 100%; margin: 4px 0 0; padding: 4px;
    list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 8px 24px rgb(0 0 0 / .2); max-height: 50vh; overflow: auto; }
  .pmd-suggest li { padding: 12px 10px; border-radius: 8px; cursor: pointer; font-size: 15px; }
  .pmd-suggest li small { display: block; color: var(--muted); font-size: 13px; }
  .pmd-suggest li[aria-selected="true"], .pmd-suggest li:hover { background: var(--amber-soft); }
  .pmd-status { font-size: 14px; color: var(--muted); }
  .pmd-status.err { color: #d64545; }
  .pmd-result { display: grid; gap: 8px; }
  .pmd-sum { display: flex; gap: 6px 16px; align-items: baseline; flex-wrap: wrap; }
  .pmd-sum b { font: 700 26px/1 var(--font-head); }
  .pmd-sum .hint { margin: 0; }
  .pmd-bar { display: flex; height: 10px; border-radius: 6px; overflow: hidden; background: var(--line); }
  .pmd-legend { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; color: var(--muted); margin: 0; padding: 0; list-style: none; }
  .pmd-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
  .pmd-hills { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; }
  .pmd-prof { width: 100%; height: 70px; display: block; color: var(--blue); }
  .pmd-profw { position: relative; padding-left: 40px; }
  .pmd-profw span { position: absolute; left: 0; font-size: 11px; color: var(--muted); }
  .pmd-profw .hi { top: 4px; } .pmd-profw .lo { bottom: 0; }
  .pmd-warn { margin: 0; padding-left: 18px; font-size: 13px; color: var(--muted); }
  .pmd-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pmd-actions button { height: 40px; padding: 0 14px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); font-size: 14px; cursor: pointer; }
  .pmd-opts, .pmd-rules { border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; }
  .pmd-opts summary, .pmd-rules summary { cursor: pointer; padding: 12px 0; font-weight: 600; }
  .pmd-opts fieldset { border: 0; margin: 0 0 12px; padding: 0; }
  .pmd-opts legend { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
  .seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .seg button { min-height: 40px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); font-size: 14px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }
  .seg-mode { flex-wrap: nowrap; }
  .seg-mode button { flex: 1; padding: 0 6px; font-size: 13px; }
  .pmd-sublabel { font-size: 13px; color: var(--muted); margin: 8px 0 4px; }
  .pmd-reset { border: 0; background: none; color: var(--blue); font-size: 13px; cursor: pointer; padding: 0 0 12px; }
  .hint { font-size: 12px; color: var(--muted); font-weight: 400; margin: 6px 0 0; }
  .pmd-check, .pmd-range { display: flex; align-items: center; gap: 8px; font-size: 14px; margin: 0 0 12px; flex-wrap: wrap; }
  .pmd-check input { width: 22px; height: 22px; }
  .pmd-range input { width: 100%; }
  .pmd-rules ul { padding-left: 18px; margin: 0 0 8px; font-size: 13px; }
  .pmd-rtable { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0; }

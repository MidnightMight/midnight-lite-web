  .pmd-dirs .meta { display: flex; gap: 12px; font-size: 12px; color: var(--muted); margin-top: 2px; }
  .pmd-dirs li.via { background: #e8f1ff; border-left: 4px solid #e08a00; padding-left: 8px; margin-left: -12px; }
  .pmd-dirs li.via button { font-weight: 700; }
  #pmd-print tr.via td { background: #e8f1ff; font-weight: 700; }

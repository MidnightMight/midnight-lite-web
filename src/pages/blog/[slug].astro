---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import YouTube from "../../components/YouTube.astro";
import AskOnYouTube from "../../components/AskOnYouTube.astro";
import Lightbox from "../../components/Lightbox.astro";
import { site, TOPICS, fmtDate, readMins } from "../../lib/site";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", (p) => !p.data.draft)).sort((a, b) => +a.data.date - +b.data.date);
  return posts.map((p, i) => ({ params: { slug: p.id }, props: { post: p, prev: posts[i - 1], next: posts[i + 1] } }));
}
const { post, prev, next } = Astro.props; const d = post.data;
const { Content } = await render(post);
const project = d.project ? await getEntry("projects", d.project) : undefined;
---
<Base title={d.title} description={d.description} image={d.cover} page="blog">
  <section class="page-hero">
    <div class="wrap prose" style="max-width:860px">
      <p class="eyebrow"><a href="/blog/">Build log</a> · {TOPICS[d.topic]}{project && <> · <a href={`/projects/${project.id}/`}>{project.data.title}</a></>}</p>
      <h1 style="font-size:clamp(2rem,5vw,3rem)">{d.title}</h1>
      <p class="muted">{fmtDate(d.date)} · {readMins(post.body)} min read · by @midnightlite</p>
    </div>
  </section>
  <section style="padding-top:20px">
    <div class="wrap" style="max-width:860px">
      <article class="prose">
        {site.videos && d.video && <YouTube id={d.video} title={d.title} />}
        <Content />
      </article>
      <div class="panel" style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:28px 0">
        {prev ? <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a> : <span class="muted">← First post</span>}
        {next ? <a href={`/blog/${next.id}/`}>{next.data.title} →</a> : <span class="muted">Latest post →</span>}
      </div>
      <AskOnYouTube video={d.video} />
    </div>
  </section>
  <Lightbox />
</Base>

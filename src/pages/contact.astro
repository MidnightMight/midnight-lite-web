---
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";
import { site } from "../lib/site";
const mail = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---
<Base title="Contact" page="contact" description="Get in touch with Midnight Lite: questions about a build, video ideas, collaborations and sponsorships.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Say hello</h1>
      <p>Questions about a build, an idea for the next video, or a collaboration. Here's where to find me.</p>
    </div>
  </section>
  <section style="padding-top:20px">
    <div class="wrap">
      <div class="grid c3">
        <div class="panel" style="border-top:5px solid #e62117"><h3>Ask about a build</h3><p class="muted">Comment under the video. I read and answer them, and other viewers often help too.</p><a class="btn yt small" href={site.youtube}>▶ YouTube</a></div>
        <div class="panel" style="border-top:5px solid var(--amber)"><h3>Suggest a video</h3><p class="muted">What should I build or explain next? Send me an email with your idea.</p><a class="btn small line" href={mail("Video idea")}>Suggest an idea</a></div>
        <div class="panel" style="border-top:5px solid var(--blue)"><h3>Get new videos</h3><p class="muted">{site.buttondown ? "New videos and build logs by email, about twice a month." : "Subscribe on YouTube to see new builds first."}</p><Subscribe small /></div>
      </div>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap" style="max-width:720px">
      <div class="panel" id="email">
        <h3>Email me</h3>
        <p class="muted">For collaborations, sponsorships, video ideas or anything private.</p>
        <p style="font-size:1.25rem;font-weight:700;margin:14px 0"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <div class="btns"><a class="btn blue" href={mail("Hello")}>Write an email</a><a class="btn line" href={mail("Collaboration / sponsorship")}>Collaboration or sponsorship</a></div>
      </div>
    </div>
  </section>
</Base>

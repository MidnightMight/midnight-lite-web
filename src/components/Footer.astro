---
import { site } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap">
    <div><a class="brand" href="/"><img src="/logo.svg" alt="" width="38" height="38">Midnight Lite</a>
      <p>3D printing, robots, photography and electric stuff. Built in the open, documented as I go.</p></div>
    <div><h4>Explore</h4><a href="/projects/">Projects</a>{site.videos && <a href="/videos/">Videos</a>}<a href="/blog/">Build log</a><a href="/tools/">Tools</a></div>
    <div><h4>Follow</h4>{site.videos && <a href={site.youtube}>YouTube</a>}{site.instagram && <a href={site.instagram}>Instagram</a>}<a href={site.github}>GitHub</a></div>
    <div><h4>Contact</h4><a href={`mailto:${site.email}`}>{site.email}</a><a href="/contact/">Contact</a><a href="/about/">About</a></div>
    <div class="legal">© {new Date().getFullYear()} Midnight Lite. Made by hand, mostly after midnight.</div>
  </div>
</footer>

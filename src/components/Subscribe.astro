---
// Newsletter box. Set "buttondown" (your Buttondown username) in src/data/site.json (or in /admin > Settings).
// Until then it shows a "Subscribe on YouTube" button instead.
import { site } from "../lib/site";
const { small = false } = Astro.props;
---
{site.buttondown ? (
  <form class="subscribe" method="post" action={`https://buttondown.com/api/emails/embed-subscribe/${site.buttondown}`} target="_blank">
    <input type="email" name="email" placeholder="you@example.com" aria-label="Email" required>
    <button class={`btn blue${small ? " small" : ""}`}>Subscribe</button>
  </form>
) : site.videos && (
  <a class={`btn yt${small ? " small" : ""}`} href={`${site.youtube}?sub_confirmation=1`}>▶ Subscribe on YouTube</a>
)}

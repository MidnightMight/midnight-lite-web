---
import { site } from "../lib/site";
const { page = "" } = Astro.props;
const links = [["/", "Home", "home"], ["/projects/", "Projects", "projects"], ["/videos/", "Videos", "videos"],
  ["/blog/", "Build log", "blog"], ["/tools/", "Tools", "tools"], ["/about/", "About", "about"], ["/contact/", "Contact", "contact"]]
  .filter(([, , key]) => site.videos || key !== "videos");
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img src="/logo.svg" alt="" width="38" height="38">Midnight Lite</a>
    <button class="menu-btn" aria-label="Menu" aria-expanded="false">Menu</button>
    <nav class="nav">{links.map(([href, label, key]) => <a href={href} class={key === page ? "active" : undefined} aria-current={key === page ? "page" : undefined}>{label}</a>)}</nav>
    {site.videos && <a class="btn yt small nav-cta" href={site.youtube}>▶ YouTube</a>}
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  btn?.addEventListener("click", () => btn.setAttribute("aria-expanded", String(document.querySelector(".nav")!.classList.toggle("open"))));
</script>
